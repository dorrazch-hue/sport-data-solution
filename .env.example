# =============================================================
# Sport Data Solution — Configuration d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env sur GitHub
# =============================================================

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sport_data
DB_USER=sport_user
DB_PASSWORD=changeme_password

# --- pgAdmin (interface web PostgreSQL) ---
PGADMIN_EMAIL=admin@sportdata.fr
PGADMIN_PASSWORD=changeme_pgadmin

# --- Google Maps API (optionnel) ---
# Si non renseigné, la validation des trajets utilisera le calcul haversine
# Obtenir une clé sur : https://console.cloud.google.com → API → Distance Matrix API
GOOGLE_MAPS_API_KEY=

# --- Slack (optionnel) ---
# Si non renseigné, les messages seront affichés dans les logs (dry-run)
# Création : https://api.slack.com/apps → Create App → Bot Token Scopes : chat:write
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#sport-activites

# --- Paramètres métier (modifiables) ---
SPORT_BONUS_RATE=0.05
WELLNESS_DAYS_THRESHOLD=15
WELLNESS_DAYS_COUNT=5
MAX_DISTANCE_WALKING_KM=15.0
MAX_DISTANCE_CYCLING_KM=25.0
COMPANY_ADDRESS=1362 Av. des Platanes, 34970 Lattes, France

# --- Airflow (pour l'orchestration) ---
AIRFLOW_UID=50000
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_password

# --- Environnement ---
# development | production
ENVIRONMENT=development
