# ============================================================
# Sport Data Solution — Image Airflow personnalisée
#
# Utilise requirements-airflow.txt (sans sqlalchemy/pandas/numpy)
# pour éviter les conflits de version avec les pins Airflow 2.10.3.
# Pour le développement local, utiliser requirements.txt complet.
# ============================================================
FROM apache/airflow:2.10.3

COPY requirements-airflow.txt /requirements-airflow.txt
RUN pip install --no-cache-dir -r /requirements-airflow.txt
